#!/bin/sh

# bm-migrate: convert a bookmark file from the old sbm format
#
#     URL description | tag tag
#
# to the tab separated one bm uses now
#
#     URL<tab>description<tab>tag tag
#
# The URL is the first word, the tags are whatever follows the last " | ", and
# a line without " | " has no tags. Comments, blank lines and lines that already
# contain a tab are passed through, so converting twice changes nothing.

usage () {
    cat <<'EOF'
usage: bm-migrate [-n] [file]
  file   the bookmark file; defaults to $BOOKMARKS, then to
         $XDG_DATA_HOME/sbm/bookmarks. "-" converts stdin to stdout.
  -n     print the converted file instead of replacing it
The original is kept as <file>.bak (or .bak.1, .bak.2, ... if that exists).
EOF
}

die () {
    printf 'bm-migrate: %s\n' "$*" >&2
    exit 1
}

convert () {
    awk '
        /\t/ || /^#/ || NF == 0 { print; next }
        {
            url = $1
            desc = $0
            sub(/^[ ]*[^ ]+[ ]*/, "", desc)
            tags = ""
            if (match(desc, / \|[^|]*$/)) {
                tags = substr(desc, RSTART + 2)
                desc = substr(desc, 1, RSTART - 1)
            }
            gsub(/^ +| +$/, "", desc)
            gsub(/^ +| +$/, "", tags)
            printf "%s\t%s\t%s\n", url, desc, tags
        }' "$@"
}

# oldlines <file>: how many lines are still in the old format.
oldlines () {
    awk '!/\t/ && !/^#/ && NF { n++ } END { print n + 0 }' "$1"
}

dryrun=
while [ $# -gt 0 ]; do
    case $1 in
        -h|--help) usage; exit 0 ;;
        -n|--dry-run) dryrun=1 ;;
        -) break ;;
        -*)
            printf 'bm-migrate: unknown option: %s\n' "$1" >&2
            usage >&2
            exit 2
            ;;
        *) break ;;
    esac
    shift
done
if [ $# -gt 1 ]; then
    printf 'bm-migrate: one file at a time\n' >&2
    exit 2
fi

file=${1:-${BOOKMARKS:-${XDG_DATA_HOME:-$HOME/.local/share}/sbm/bookmarks}}

if [ "$file" = - ]; then
    convert
    exit
fi

[ -f "$file" ] || die "no such file: $file"
[ -r "$file" ] || die "cannot read $file"

if [ -n "$dryrun" ]; then
    convert "$file"
    exit
fi

count=$(oldlines "$file")
if [ "$count" -eq 0 ]; then
    printf 'nothing to migrate in %s\n' "$file"
    exit 0
fi

# Never overwrite an earlier backup: it may be the only copy of the original.
backup=$file.bak
n=0
while [ -e "$backup" ]; do
    n=$((n + 1))
    backup=$file.bak.$n
done
cp -p "$file" "$backup" || die "could not back up to $backup"

# Through cat rather than mv, so that a symlinked bookmark file stays a symlink
# and keeps its permissions.
tmp=$(mktemp "${TMPDIR:-/tmp}/sbm.XXXXXX") || die 'mktemp failed'
trap 'rm -f "$tmp"' EXIT INT TERM
if ! convert "$backup" > "$tmp" || ! cat "$tmp" > "$file"; then
    die "could not rewrite $file; the original is in $backup"
fi

printf 'migrated %d lines in %s (original kept as %s)\n' "$count" "$file" "$backup"
