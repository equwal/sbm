#!/usr/bin/make -f

%:
	dh $@

# dh_auto_test finds the "check" target on its own, since there is no
# "test" target. It runs shellcheck -s sh over every script and then the
# test suite, which scripts the menu, the clipboard and curl: no display,
# no network. The override is here only to carry this comment.
override_dh_auto_test:
	dh_auto_test

override_dh_auto_install:
	dh_auto_install -- PREFIX=/usr
